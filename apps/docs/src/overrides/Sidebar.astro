---
/**
 * 按所在体系切换侧边栏：/dev/ 下只显示「开发文档」分组，/design/ 下只显示
 * 「产品设计」下的分组，其余页面只显示使用文档分组。三个体系共用一个站点，导航互不混入。
 */
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { sectionOf, SECTION_GROUPS } from './sections';

const route = Astro.locals.starlightRoute;
const section = sectionOf(Astro.url.pathname);
const isOwnGroup = (label: string) =>
  section === 'guide'
    ? !SECTION_GROUPS.dev.includes(label) && !SECTION_GROUPS.design.includes(label)
    : SECTION_GROUPS[section].includes(label);
route.sidebar = route.sidebar.filter((entry) => isOwnGroup(entry.label));
---

<SidebarPersister>
  <SidebarSublist sublist={route.sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
