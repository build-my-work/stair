{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "rootDir": "../..",
    "baseUrl": "../..",
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@craft-agent/shared": ["packages/shared/src/index.ts"],
      "@craft-agent/shared/*": ["packages/shared/src/*"]
